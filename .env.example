# Razorpay test-mode credentials — Settings → API Keys (ensure Test Mode is toggled on)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postgres connection string (Neon/Supabase free tier both work)
DATABASE_URL=

# LLM providers — Groq is the default, Gemini is reserved for hard-reasoning tasks only
GROQ_API_KEY=
GEMINI_API_KEY=

# Webhook signature verification — a secret string YOU choose (e.g.
# openssl rand -base64 24), entered into Razorpay's webhook config to
# match. Required since Layer 3.
RAZORPAY_WEBHOOK_SECRET=

# AES-256-GCM key for encrypting per-merchant Razorpay credentials at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# This deployment's own public origin — scheme included, no trailing slash
# (e.g. https://thirdman-abc123-ew.a.run.app). Leave blank locally; the
# app falls back to http://localhost:3000.
#
# Required on any host that doesn't inject its own URL, which includes
# Cloud Run. Without it, the OAuth redirect_uri resolves to localhost and
# a merchant signing in with Google/GitHub gets sent to their own machine.
# Whatever you set here must also be registered as an authorized redirect
# URI in the Google and GitHub OAuth apps, as <APP_URL>/api/auth/google/callback
# and <APP_URL>/api/auth/github/callback.
APP_URL=
