# Razorpay test-mode credentials — Settings → API Keys (ensure Test Mode is toggled on)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postgres connection string (Neon/Supabase free tier both work)
DATABASE_URL=

# LLM providers — Groq is the default, Gemini is reserved for hard-reasoning tasks only
GROQ_API_KEY=
GEMINI_API_KEY=

# Webhook signature verification — a secret string YOU choose, entered into
# Razorpay's webhook config to match. Not required until Layer 2.
RAZORPAY_WEBHOOK_SECRET=
