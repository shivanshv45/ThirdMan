# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated secrets — never commit
.seed-keys.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project docs — local reference only, not pushed
/ARCHITECTURE.md
/CLAUDE.md
/DECISIONS.md
/FAILURES.md
/PROGRESS.md
/prd.md
/plans/
/DESIGN_SPEC.md
/TESTING.md

# design reference material — Claude Design source files and screenshots
# used to build the landing page UI; not app assets, never served or
# imported at runtime, not for the public repo.
/public/design_zip/

# superseded background video from an earlier hero implementation — the
# hero now uses a procedural canvas animation (AntCanvas.tsx) instead, and
# nothing in src/ references this file. Left on disk locally rather than
# deleted in case of a future rollback, but never pushed.
/public/bg_video.mp4
