# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated secrets — never commit
.seed-keys.local.json

# agent-buyer/ is a standalone package (Layer 19) with its own
# node_modules and its own run logs — local run artifacts, not source.
/agent-buyer/node_modules
/agent-buyer/run-logs

# cli/ (the "thirdman" merchant CLI, Layer 20) is the same shape — its
# own standalone package with its own node_modules. Its published build
# output goes to cli/dist (tsconfig.build.json); tsconfig.json itself is
# noEmit, but an editor's own tsc watch/emit-on-save task can still drop
# stray .js next to cli/src's .ts sources — ignored so that never lands.
/cli/node_modules
/cli/dist
/cli/src/**/*.js

# vscode-extension (Layer 24) is also a standalone package
/vscode-extension/node_modules
/vscode-extension/out


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project docs — local reference only, not pushed
/ARCHITECTURE.md
/CLAUDE.md
/DECISIONS.md
/FAILURES.md
/PROGRESS.md
/prd.md
/plans/
/DESIGN_SPEC.md
/TESTING.md

# design reference material — Claude Design source files and screenshots
# used to build the landing page UI; not app assets, never served or
# imported at runtime, not for the public repo.
/public/design_zip/

# superseded background video from an earlier hero implementation — the
# hero now uses a procedural canvas animation (AntCanvas.tsx) instead, and
# nothing in src/ references this file. Left on disk locally rather than
# deleted in case of a future rollback, but never pushed.
/public/bg_video.mp4

# local scratchpad
/scratch/

# shopify theme app extension dependencies
/shopify-theme-extension/node_modules
